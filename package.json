{
  "name": "nexusinfra-monorepo",
  "version": "0.1.0",
  "description": "NexusInfra — infrastructure & server management platform (TypeScript). Integrates with FinVault via RabbitMQ.",
  "type": "module",
  "private": true,
  "workspaces": [
    "services/*",
    "shared"
  ],
  "scripts": {
    "dev:shared": "npm run dev --workspace=shared",
    "dev:control-room": "npm run dev --workspace=services/control-room",
    "dev": "concurrently \"npm run dev:shared\" \"npm run dev:control-room\"",
    "build": "npm run build --workspace=shared && npm run build --workspaces --if-present",
    "install:all": "npm install",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^1.6.0"
  }
}
