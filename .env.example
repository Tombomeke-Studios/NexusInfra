# NexusInfra environment configuration
# Copy to .env and fill in real values.
#
# IMPORTANT — FinVault integration:
# To exchange billing/payment events with FinVault, RABBITMQ_URL and
# FINVAULT_MESSAGE_KEY MUST match FinVault's values. The message key derives the
# AES-256-GCM key used to encrypt/decrypt event payloads across both platforms —
# if they differ, FinVault cannot decrypt NexusInfra's events (and vice versa).

# ── Messaging ────────────────────────────────────────────────────────
# RabbitMQ broker. In a combined deployment, point this at FinVault's broker
# (e.g. amqp://guest:guest@finvault-rabbitmq:5672) so both platforms share the
# same `finvault.events` topic exchange. Standalone dev uses NexusInfra's own.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# HMAC/encryption key for event payloads — MUST equal FinVault's FINVAULT_MESSAGE_KEY.
# Leave empty to send plaintext payloads (local dev only; not interoperable).
FINVAULT_MESSAGE_KEY=

# ── Control Room ─────────────────────────────────────────────────────
# HTTP port for the Control Room health/status endpoint.
PORT=9000
