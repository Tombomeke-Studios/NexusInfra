# NexusInfra environment configuration
# Copy to .env and fill in real values.
#
# IMPORTANT — FinVault integration:
# To exchange billing/payment events with FinVault, RABBITMQ_URL and
# FINVAULT_MESSAGE_KEY MUST match FinVault's values. The message key derives the
# AES-256-GCM key used to encrypt/decrypt event payloads across both platforms —
# if they differ, FinVault cannot decrypt NexusInfra's events (and vice versa).

# ── Edition (open-core split) ────────────────────────────────────────
# `community` (default) = the standalone self-hosted manager; billing/FinVault
# off. `hosted` = the multi-tenant hosting-provider scenario; billing on. All
# services read this; the dashboard reads it from the Orchestrator's GET /config.
# Anything unrecognised falls back to `community`. See docs/billing.md.
NEXUS_EDITION=community

# ── Messaging ────────────────────────────────────────────────────────
# RabbitMQ broker. In a combined deployment, point this at FinVault's broker
# (e.g. amqp://guest:guest@finvault-rabbitmq:5672) so both platforms share the
# same `finvault.events` topic exchange. Standalone dev uses NexusInfra's own.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# HMAC/encryption key for event payloads — MUST equal FinVault's FINVAULT_MESSAGE_KEY.
# Leave empty to send plaintext payloads (local dev only; not interoperable).
FINVAULT_MESSAGE_KEY=

# ── Control Room ─────────────────────────────────────────────────────
# HTTP port for the Control Room health/status endpoint.
PORT=9000

# ── Orchestrator ─────────────────────────────────────────────────────
# SQLite database (Prisma). Relative paths resolve against the orchestrator
# workspace; docker-compose points this at a mounted volume instead.
DATABASE_URL=file:./orchestrator.db

# Hostname reported to users for connecting to a managed database (#109). Defaults
# to localhost; set to the node's reachable host/IP in a multi-host deployment.
DATABASE_PUBLIC_HOST=localhost

# Billing Bridge internal HTTP, used by the Orchestrator for plan-quota checks in
# the hosted edition (#148). Ignored in community. Fails open if unreachable.
BILLING_BRIDGE_URL=http://billing-bridge:9300

# Control Room internal HTTP, used by the Orchestrator to surface service/node
# health to the dashboard (#157). Reads reachable:false if it's down.
CONTROL_ROOM_URL=http://control-room:9000

# ── Billing Bridge (hosted edition only) ─────────────────────────────
# Inert unless NEXUS_EDITION=hosted. SQLite store (Prisma); docker-compose points
# this at a mounted volume. BILLING_WALLET_ID is NexusInfra's receiver wallet id
# used on payment.request top-ups (FinVault resolves the paying user's wallet).
# BILLING_DATABASE_URL is set per-service via DATABASE_URL; port defaults to 9300.
BILLING_WALLET_ID=nexusinfra

# ── Service-to-service auth (#169) ───────────────────────────────────
# Shared secret the Orchestrator presents to the Node Agent's internal API
# (container exec, file writes, the interactive terminal). The Agent rejects any
# request without it. MUST be a strong random value in any real deployment — the
# built-in fallback is a well-known dev default. Both services must agree on it.
INTERNAL_API_TOKEN=dev-internal-token

# ── Node Agent ───────────────────────────────────────────────────────
# Where the Orchestrator can reach THIS agent's HTTP/WS API. Advertised on the
# node heartbeat so multi-node setups route each deployment's file/exec/terminal/
# backup calls to the node that actually hosts it (#171). Defaults to
# http://<hostname>:<PORT>, which works on a compose/DNS network; set it
# explicitly for anything else. Leave unset for single-node — the Orchestrator
# then falls back to its NODE_AGENT_URL.
# AGENT_URL=http://node-agent:9100

# Directory on the node where backup tarballs are stored (#110). Defaults to a
# temp dir; point it at a mounted volume so backups survive container restarts.
# BACKUP_DIR=/var/lib/nexusinfra/backups

# Secret used to sign the stub dashboard-login JWTs (local dev only; the full
# gateway/FinVault-JWT integration is a later phase). Any non-empty string works.
# The API Gateway validates tokens with this same secret until the FinVault JWT
# lands (#17).
JWT_SECRET=dev-secret

# ── API Gateway (#20) ────────────────────────────────────────────────
# Single external entry point (:9400). Reverse-proxies to the Orchestrator with
# CORS, per-client rate limiting and JWT validation.
ORCHESTRATOR_URL=http://orchestrator:9200
RATE_LIMIT_PER_SEC=50
RATE_LIMIT_BURST=100
