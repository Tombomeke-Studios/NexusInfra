# NexusInfra environment configuration
# Copy to .env and fill in real values.
#
# IMPORTANT — FinVault integration:
# To exchange billing/payment events with FinVault, RABBITMQ_URL and
# FINVAULT_MESSAGE_KEY MUST match FinVault's values. The message key derives the
# AES-256-GCM key used to encrypt/decrypt event payloads across both platforms —
# if they differ, FinVault cannot decrypt NexusInfra's events (and vice versa).

# ── Edition (open-core split) ────────────────────────────────────────
# `community` (default) = the standalone self-hosted manager; billing/FinVault
# off. `hosted` = the multi-tenant hosting-provider scenario; billing on. All
# services read this; the dashboard reads it from the Orchestrator's GET /config.
# Anything unrecognised falls back to `community`. See docs/billing.md.
NEXUS_EDITION=community

# ── Messaging ────────────────────────────────────────────────────────
# RabbitMQ broker. In a combined deployment, point this at FinVault's broker
# (e.g. amqp://guest:guest@finvault-rabbitmq:5672) so both platforms share the
# same `finvault.events` topic exchange. Standalone dev uses NexusInfra's own.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# HMAC/encryption key for event payloads — MUST equal FinVault's FINVAULT_MESSAGE_KEY.
# Leave empty to send plaintext payloads (local dev only; not interoperable).
FINVAULT_MESSAGE_KEY=

# ── Control Room ─────────────────────────────────────────────────────
# HTTP port for the Control Room health/status endpoint.
PORT=9000

# ── Orchestrator ─────────────────────────────────────────────────────
# SQLite database (Prisma). Relative paths resolve against the orchestrator
# workspace; docker-compose points this at a mounted volume instead.
DATABASE_URL=file:./orchestrator.db

# Hostname reported to users for connecting to a managed database (#109). Defaults
# to localhost; set to the node's reachable host/IP in a multi-host deployment.
DATABASE_PUBLIC_HOST=localhost

# ── Node Agent ───────────────────────────────────────────────────────
# Directory on the node where backup tarballs are stored (#110). Defaults to a
# temp dir; point it at a mounted volume so backups survive container restarts.
# BACKUP_DIR=/var/lib/nexusinfra/backups

# Secret used to sign the stub dashboard-login JWTs (local dev only; the full
# gateway/FinVault-JWT integration is a later phase). Any non-empty string works.
JWT_SECRET=dev-secret
