# NexusInfra — Hosted edition configuration
# Copy to `.env` and fill in every required value before starting.

# ── Required ──────────────────────────────────────────────────────────
# The first administrator. Customers register themselves in this edition; this
# account is the one that manages the installation.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Signs the panel's login tokens:  openssl rand -hex 32
JWT_SECRET=

# Shared secret between the Orchestrator and each Node Agent's internal API,
# which can start containers and open shells. Another long random value.
INTERNAL_API_TOKEN=

# Derives the encryption for event payloads on the shared bus. This MUST equal
# FinVault's value — the two platforms exchange payment and invoice events, and
# neither can read the other's events if the keys differ.
FINVAULT_MESSAGE_KEY=

# ── Optional ──────────────────────────────────────────────────────────
# Pin a released version rather than tracking the moving `hosted` tag:
# NEXUSINFRA_VERSION=0.2.0-hosted

# NexusInfra's receiver wallet id, referenced on top-up requests to FinVault.
# BILLING_WALLET_ID=nexusinfra

# DASHBOARD_PORT=8095
# The API gateway (scripts, nexusctl), published on every interface.
# GATEWAY_PORT=9400
# The orchestrator's own API, published on 127.0.0.1 only.
# ORCHESTRATOR_PORT=9200
# NODE_ID=node-local
# DATABASE_PUBLIC_HOST=localhost

# Broker credentials. When sharing FinVault's broker, remove the `rabbitmq`
# service from docker-compose.yml and point RABBITMQ_URL at it instead of
# setting these.
# RABBITMQ_USER=guest
# RABBITMQ_PASS=guest

# Mail (#236). Customers register themselves here, so set this: without it
# there is no password reset (#344) and no email verification (#367), and a
# customer who forgets their password has no way back in. PANEL_URL is the
# panel's public address — links are built from it, never from the request.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_FROM="NexusInfra <panel@example.com>"
# PANEL_URL=https://panel.example.com

# How many proxies sit in front of the orchestrator, so rate limiting sees each
# customer instead of the proxy (#401). The panel's own nginx is one; put your
# own reverse proxy (Caddy, nginx, Traefik) in front of the panel and it is 2.
# TRUST_PROXY=1

# true requires every account to enrol a second factor (#229).
# REQUIRE_TOTP=false

# Largest file upload through the panel.
# MAX_UPLOAD_BYTES=64mb

# Off-site backups (#232): every backup is also copied to an S3-compatible
# bucket (AWS, Backblaze B2, Wasabi, R2, MinIO). Off unless the bucket and both
# keys are set. See docs/images.md for the rest (prefix, path style).
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=us-east-1

# Monitoring (#355) — Prometheus + Grafana with the NexusInfra dashboard:
#   docker compose --profile monitoring up -d
# Grafana will not start without a password of its own.
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3000
# Puts every service's /metrics behind a bearer token; Prometheus sends it.
# Recommended when the orchestrator or gateway port is reachable from outside.
# METRICS_TOKEN=
