# NexusInfra — Hosted edition configuration
# Copy to `.env` and fill in every required value before starting.

# ── Required ──────────────────────────────────────────────────────────
# The first administrator. Customers register themselves in this edition; this
# account is the one that manages the installation.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Signs the panel's login tokens:  openssl rand -hex 32
JWT_SECRET=

# Shared secret between the Orchestrator and each Node Agent's internal API,
# which can start containers and open shells. Another long random value.
INTERNAL_API_TOKEN=

# Derives the encryption for event payloads on the shared bus. This MUST equal
# FinVault's value — the two platforms exchange payment and invoice events, and
# neither can read the other's events if the keys differ.
FINVAULT_MESSAGE_KEY=

# ── Optional ──────────────────────────────────────────────────────────
# Pin a released version rather than tracking the moving `hosted` tag:
# NEXUSINFRA_VERSION=0.2.0-hosted

# NexusInfra's receiver wallet id, referenced on top-up requests to FinVault.
# BILLING_WALLET_ID=nexusinfra

# DASHBOARD_PORT=8095
# NODE_ID=node-local
# DATABASE_PUBLIC_HOST=localhost

# Broker credentials. When sharing FinVault's broker, remove the `rabbitmq`
# service from docker-compose.yml and point RABBITMQ_URL at it instead of
# setting these.
# RABBITMQ_USER=guest
# RABBITMQ_PASS=guest
