# NexusInfra — Community edition configuration
# Copy to `.env` and fill in the three required values before starting.

# ── Required ──────────────────────────────────────────────────────────
# The administrator account seeded on first start. Change this: the panel
# controls Docker on this machine, and the service warns on every start while a
# default password is in use.
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=

# Signs the panel's login tokens. Anyone holding this can mint a token for any
# account, so use a long random value:  openssl rand -hex 32
JWT_SECRET=

# Shared secret the Orchestrator presents to the Node Agent's internal API,
# which can start containers and open shells. Also a long random value.
INTERNAL_API_TOKEN=

# ── Optional ──────────────────────────────────────────────────────────
# Pin a released version instead of tracking the moving `community` tag, so
# upgrades are something you choose:  NEXUSINFRA_VERSION=0.2.0-community
# NEXUSINFRA_VERSION=community

# Where the panel is served.
# DASHBOARD_PORT=8095
# The API gateway (scripts, nexusctl), published on every interface.
# GATEWAY_PORT=9400
# The orchestrator's own API, published on 127.0.0.1 only.
# ORCHESTRATOR_PORT=9200

# Identifier for this machine as a node. Give each host a distinct one when you
# run more than one agent.
# NODE_ID=node-local

# Hostname users are given when connecting to a database this panel provisions.
# Set it to the machine's reachable address if that isn't localhost.
# DATABASE_PUBLIC_HOST=localhost

# Broker credentials. The broker is not published outside the compose network,
# but change these anyway if anything else can reach it.
# RABBITMQ_USER=guest
# RABBITMQ_PASS=guest

# Encrypts event payloads on the bus. The community edition talks to nobody
# else, so this is optional here — it matters for the hosted edition, which
# shares a broker with FinVault.
# FINVAULT_MESSAGE_KEY=

# Mail (#236). Turns on email notifications; with PANEL_URL also password
# reset by email (#344). Off while SMTP_URL is unset.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_FROM="NexusInfra <panel@example.com>"
# The panel's public address — reset links are built from this, never from
# the request.
# PANEL_URL=https://panel.example.com

# How many proxies sit in front of the orchestrator, so rate limiting sees each
# caller instead of the proxy (#401). The panel's own nginx is one; put your own
# reverse proxy (Caddy, nginx, Traefik) in front of the panel and it is 2.
# TRUST_PROXY=1

# true requires every account to enrol a second factor (#229).
# REQUIRE_TOTP=false

# Largest file upload through the panel.
# MAX_UPLOAD_BYTES=64mb

# Off-site backups (#232): every backup is also copied to an S3-compatible
# bucket (AWS, Backblaze B2, Wasabi, R2, MinIO). Off unless the bucket and both
# keys are set. See docs/images.md for the rest (prefix, path style).
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=us-east-1

# Importing existing server directories (#268) needs a bind mount as well as a
# variable, so it is not switched on here: add IMPORT_ROOT and a volume to the
# node-agent service yourself — docs/images.md explains why it is off.

# Monitoring (#355) — Prometheus + Grafana with the NexusInfra dashboard:
#   docker compose --profile monitoring up -d
# Grafana will not start without a password of its own.
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3000
# Puts every service's /metrics behind a bearer token; Prometheus sends it.
# Recommended when the orchestrator or gateway port is reachable from outside.
# METRICS_TOKEN=
